# Cappy   root environment variables
#
# There is NO live Supabase project yet. These are placeholders so the app
# builds and packages/api's createSupabaseClient() throws a clear
# "not configured" error instead of crashing at import time. See
# docs/DB_SETUP_GUIDE.md (schema/RLS/seed) and docs/BACKEND_SSO_SETUP.md
# (OAuth + how to actually provision the project) for the real setup steps.
#
# Copy this file to `.env` (gitignored) and fill in real values once a
# Supabase project exists: Supabase dashboard → Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key   safe to expose client-side, RLS is what protects data.
# Do NOT put the "service_role" key in any .env file that ships to a client.
SUPABASE_ANON_KEY=your-anon-public-key
