# Cappy mobile   Expo environment variables
#
# No live Supabase project yet   see docs/DB_SETUP_GUIDE.md and
# docs/BACKEND_SSO_SETUP.md. Copy to `.env.local` (gitignored) and fill in
# real values once a project exists: Supabase dashboard → Settings → API.
#
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to client code
# (process.env.EXPO_PUBLIC_SUPABASE_URL)   do not rename this prefix.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
