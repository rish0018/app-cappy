# Cappy web   Vite environment variables
#
# No live Supabase project yet   see docs/DB_SETUP_GUIDE.md and
# docs/BACKEND_SSO_SETUP.md. Copy to `.env.local` (gitignored) and fill in
# real values once a project exists: Supabase dashboard → Settings → API.
#
# Vite only exposes vars prefixed with VITE_ to client code
# (import.meta.env.VITE_SUPABASE_URL)   do not rename this prefix.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
